<?xml version="1.0"?>
<package format="3">
  <name>ros2_amr_bench</name>
  <version>0.1.0</version>
  <description>Simulated differential-drive AMR with a CAN motor bridge and fault diagnostics</description>
  <maintainer email="izzuwan.alif@gmail.com">Alif Izzuwan</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-can</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
